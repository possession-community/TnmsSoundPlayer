<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\config.props" />

    <PropertyGroup>
        <RootNamespace>TnmsSoundPlayer</RootNamespace>
        <!-- Needed so NuGet runtime assets (Concentus.dll) land in the output for deploy. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ModSharp.Sharp.Shared" Version="2.1.137" ExcludeAssets="runtime" />
        <PackageReference Include="Concentus" Version="1.1.7" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TnmsSoundPlayer.Shared\TnmsSoundPlayer.Shared.csproj" Private="false" ExcludeAssets="runtime" />
    </ItemGroup>

    <Target Name="CopyPlugin" AfterTargets="Build" Condition="'$(MOD_SHARP_DIR)' != ''">
        <ItemGroup>
            <PluginFiles Include="$(TargetDir)$(ProjectName).deps.json" />
            <PluginFiles Include="$(TargetDir)$(ProjectName).dll" />
            <PluginFiles Include="$(TargetDir)Concentus.dll" />
            <!-- config.props uses embedded debug info, so no .pdb is produced -->
            <PluginFiles Include="$(TargetDir)$(ProjectName).pdb" Condition="Exists('$(TargetDir)$(ProjectName).pdb')" />
        </ItemGroup>
        <Message Text="Copying the plugin files to ModSharp modules directory" Importance="High" />
        <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(MOD_SHARP_DIR)\modules\$(ProjectName)\reload" />
        <Message Text="Successfully copied the plugin files" Importance="High" />
    </Target>
</Project>
